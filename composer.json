{
    "name": "rajanvijayan/ai-engine",
    "description": "Multi-provider AI library for PHP - supports Gemini, Meta Llama, and Groq",
    "type": "library",
    "keywords": ["ai", "gemini", "llama", "groq", "chatbot", "conversation"],
    "autoload": {
        "psr-4": {
            "AIEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AIEngine\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "license": "MIT"
}