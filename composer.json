{
    "name": "rajanvijayan/ai-engine",
    "description": "Multi-provider AI library for PHP - supports OpenAI, Anthropic Claude, Gemini, xAI Grok, DeepSeek, Mistral, Groq, and Meta Llama",
    "type": "library",
    "keywords": ["ai", "llm", "openai", "gpt", "anthropic", "claude", "gemini", "xai", "grok", "deepseek", "mistral", "groq", "llama", "rag", "chatbot", "conversation"],
    "autoload": {
        "psr-4": {
            "AIEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AIEngine\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "lint": [
            "@phpstan",
            "@cs-check"
        ],
        "ci": [
            "@lint",
            "@test"
        ]
    },
    "license": "MIT"
}
